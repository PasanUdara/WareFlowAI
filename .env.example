# ==============================================================================
# WareFlow AI - Environment Configuration Template
# Copy this file to .env and configure values before starting services.
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Security & JWT Authentication
JWT_SECRET_KEY=wareflow_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Local persistent account database (default: data/wareflow_users.sqlite3)
WAREFLOW_USERS_DB_PATH=data/wareflow_users.sqlite3
GOOGLE_CLIENT_ID=404192462595-76cb28fg4ueh8k1jltats6rqge88blea.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=404192462595-76cb28fg4ueh8k1jltats6rqge88blea.apps.googleusercontent.com

# LLM & OpenAI API (Task Planning & Compliance RAG)
OPENAI_API_KEY=sk-placeholder-your-openai-api-key
OPENAI_MODEL_NAME=gpt-4o-mini

# Qdrant Vector Database
# QDRANT_MODE modes: 'auto' (fallback to memory), 'memory' (in-memory store for testing/CI), 'server' (fail-fast connection to server).
# Note: Use 'server' mode in production/docker-compose to fail fast if Qdrant is unreachable.
QDRANT_MODE=auto
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=warehouse_sops

# Warehouse Simulation Engine
GRID_WIDTH=20
GRID_HEIGHT=15
SIMULATION_TICK_RATE_HZ=2
NUM_ROBOTS=4
